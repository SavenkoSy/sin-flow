#!/usr/bin/env bash
set -uo pipefail

TEST_PATH='(^|/)(spec|specs|test|tests|__tests__)/|_spec\.[a-z]+$|_test\.[a-z]+$|\.test\.[a-z]+$|\.spec\.[a-z]+$|(^|/)test_[^/]*\.py$'
SUPPORT_PATH='(^|/)(spec|specs|test|tests|__tests__)/(.*/)?(support|fixtures|factories|helpers)/'

usage() {
  cat >&2 <<'EOF'
usage: sin-flow-gate run <log> <commands-file>
       sin-flow-gate count <log>
       sin-flow-gate canary <work_dir> <unit> <base> <spec_cmd> <file>...
       sin-flow-gate verdict <work_dir> <unit> <sha|uncommitted> <clean|skipped>
       sin-flow-gate notes <key>   (paths on stdin, one per line)
       sin-flow-gate green-for <work_dir> <sha>
EOF
  exit 2
}

split_commands() {
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line == *'`'* ]]; then
      grep -oE '`[^`]+`' <<<"$line" | sed -E 's/^`//; s/`$//'
    else
      printf '%s\n' "$line"
    fi
  done <"$1" | sed -E 's/^[[:space:]]*(-[[:space:]]+)?//; s/[[:space:]]+$//' | sed -E "s/^\"(.*)\"$/\1/; s/^'(.*)'$/\1/" | grep -v '^$'
}

count_tests() {
  awk '
    /no tests ran|No test files found/ { last = "zero" }
    /[0-9]+ examples?, [0-9]+ failures?/ || /[0-9]+ runs, [0-9]+ assertions/ || /(^|[^0-9a-z])[0-9]+ passed/ || /(^|[^0-9a-z])[0-9]+ failed/ { last = $0 }
    END {
      if (last == "") exit
      if (last == "zero") { print 0; exit }
      n = 0; pending = 0; runs = 0; skips = 0; examples = 0
      line = last
      while (match(line, /[0-9]+ [a-z]+/)) {
        word = substr(line, RSTART, RLENGTH); split(word, part, " ")
        if (part[2] ~ /^examples?$/) examples = part[1]
        else if (part[2] == "pending") pending = part[1]
        else if (part[2] == "runs") runs = part[1]
        else if (part[2] ~ /^skips?$/) skips = part[1]
        else if (part[2] == "passed" || part[2] == "failed" || part[2] ~ /^errors?$/) n += part[1]
        line = substr(line, RSTART + RLENGTH)
      }
      if (examples > 0 || last ~ /examples?,/) print examples - pending
      else if (runs > 0 || last ~ /runs,/) print runs - skips
      else print n
    }' "$1"
}

tree_with() {
  local scratch index tree
  scratch=$(mktemp -d)
  index=$(git rev-parse --git-path index)
  [ -f "$index" ] && cp -p "$index" "$scratch/index"
  tree=$(GIT_INDEX_FILE="$scratch/index" git add "$1" >/dev/null 2>&1 && GIT_INDEX_FILE="$scratch/index" git write-tree 2>/dev/null)
  rm -rf "$scratch"
  [ -n "$tree" ] && echo "tree $tree"
}

record_green() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  {
    echo "head $(git rev-parse --verify -q HEAD || echo none)"
    tree_with --all
    tree_with --update
  } >"$1.green"
}

cmd_run() {
  local log=$1 commands=$2 section status tests gated=0
  [ -f "$commands" ] || usage
  rm -f "$log.tail" "$log.green"
  section=$(mktemp)
  { echo "commands:"; split_commands "$commands" | sed 's/^/  /'; } >"$log"
  while IFS= read -r cmd; do
    [ "$cmd" = true ] || gated=1
    echo "=== $cmd ===" >>"$log"
    bash -c "$cmd" >"$section" 2>&1
    status=$?
    cat "$section" >>"$log"
    tests=$(count_tests "$section")
    echo "=== exit $status · tests ${tests:-none} ===" >>"$log"
    if [ "$status" -ne 0 ]; then
      tail -40 "$section" >"$log.tail"
      rm -f "$section"
      echo "red: $cmd (exit $status)"
      return 1
    fi
    if [ "$tests" = 0 ]; then
      tail -40 "$section" >"$log.tail"
      rm -f "$section"
      echo "red: $cmd ran 0 tests"
      return 1
    fi
  done < <(split_commands "$commands")
  rm -f "$section"
  [ "$gated" -eq 1 ] && record_green "$log"
  tail -40 "$log" >"$log.tail"
  echo "green"
}

cmd_green_for() {
  local work=$1 sha=$2 tree
  tree=$(git rev-parse --verify -q "$sha^{tree}") || { echo "no green gate for $sha: not a commit here"; return 1; }
  if grep -qsx "tree $tree" "$work"/*.green; then
    echo "green gate for $sha"
    return 0
  fi
  echo "no green gate for $sha"
  return 1
}

cmd_canary() {
  local work=$1 unit=$2 base=$3 spec_cmd=$4
  shift 4
  local log="$work/canary-$unit.log" patch="$work/canary-$unit.patch" aside="$work/canary-$unit-aside"
  local tests=() code=() untracked=() f status count
  for f in "$@"; do
    if grep -qE "$SUPPORT_PATH" <<<"$f"; then continue
    elif grep -qE "$TEST_PATH" <<<"$f"; then [ -e "$f" ] && tests+=("$f")
    else code+=("$f")
    fi
  done
  if [ ${#code[@]} -eq 0 ]; then
    echo "CANARY none: no code file in the unit" | tee "$log"
    return 0
  fi
  if [ ${#tests[@]} -eq 0 ]; then
    echo "CANARY none: no spec file in the unit. When the unit has spec files, add them to its line and run the canary again" | tee "$log"
    return 0
  fi
  base=$(git merge-base HEAD "origin/$base" 2>/dev/null || git rev-parse --verify -q "$base^{commit}") || { echo "CANARY blocked: base not found" | tee "$log"; return 3; }
  git diff "$base" -- "${code[@]}" >"$patch"
  while IFS= read -r f; do untracked+=("$f"); done < <(git ls-files --others --exclude-standard -- "${code[@]}")
  restore() {
    [ -s "$patch" ] && git apply "$patch"
    for f in "${untracked[@]+"${untracked[@]}"}"; do mkdir -p "$(dirname "$f")"; mv "$aside/$f" "$f"; done
  }
  trap restore INT TERM
  [ -s "$patch" ] && { git apply -R "$patch" || { echo "CANARY blocked: the patch does not reverse cleanly ($patch)" | tee "$log"; return 3; }; }
  for f in "${untracked[@]+"${untracked[@]}"}"; do mkdir -p "$aside/$(dirname "$f")"; mv "$f" "$aside/$f"; done
  { echo "=== reverted: $spec_cmd ${tests[*]} ==="; bash -c "$spec_cmd $(printf '%q ' "${tests[@]}")" 2>&1; } >"$log"
  status=$?
  echo "CANARY base: ${base:0:12} · reverted: ${code[*]}" >>"$log"
  restore
  trap - INT TERM
  if ! git diff "$base" -- "${code[@]}" | cmp -s - "$patch"; then
    echo "CANARY blocked: the code did not come back; re-apply $patch" | tee -a "$log"
    return 3
  fi
  [ "$status" -ne 0 ] && echo "CANARY reverted: red" >>"$log" || echo "CANARY reverted: green" >>"$log"
  { echo "=== restored: $spec_cmd ${tests[*]} ==="; bash -c "$spec_cmd $(printf '%q ' "${tests[@]}")" 2>&1; } >"$log.restored"
  status=$?
  count=$(count_tests "$log.restored")
  cat "$log.restored" >>"$log"
  rm -f "$log.restored"
  [ "$status" -eq 0 ] && echo "CANARY restored: green tests ${count:-none}" >>"$log" || echo "CANARY restored: red" >>"$log"
  grep '^CANARY ' "$log" | paste -sd ' ' -
}

cmd_verdict() {
  local work=$1 unit=$2 sha=$3 audit=$4 log="$1/canary-$2.log" reverted restored tests
  if [ ! -f "$log" ]; then
    echo "Unit $unit: complete ($sha, audit $audit)"
    return 0
  fi
  reverted=$(sed -n 's/^CANARY reverted: //p' "$log")
  restored=$(sed -n 's/^CANARY restored: //p' "$log")
  tests=$(sed -n 's/^CANARY restored: green tests //p' "$log")
  if grep -q '^CANARY none' "$log"; then
    echo "Unit $unit: complete ($sha, audit $audit, canary none)"
  elif [ "$reverted" = green ]; then
    echo "Unit $unit: not proven: its specs pass with its code reverted"
  elif [[ $restored != green* ]]; then
    echo "Unit $unit: not proven: its specs fail with its code in place"
  elif [ "$tests" = 0 ]; then
    echo "Unit $unit: not proven: its specs ran 0 tests"
  elif [ "$reverted" = red ]; then
    echo "Unit $unit: complete ($sha, audit $audit, canary red, ${tests} tests)"
  else
    echo "Unit $unit: not proven: canary log has no result"
  fi
}

cmd_notes() {
  local work="$HOME/.claude/sin-flow/work" globs hashes p hit hits=0
  globs="$(sin-flow-profile user notes_globs 2>/dev/null) $(sin-flow-profile "$1" get notes.paths 2>/dev/null)"
  hashes=$(find "$work" -type f ! -path '*/.git/*' -exec git hash-object {} + 2>/dev/null | sort -u)
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    [ ! -e "$p" ] && [ ! -L "$p" ] && git cat-file -e "HEAD:$p" 2>/dev/null && continue
    hit=$(printf '%s\n' "$p" | awk -v globs="$globs" 'function g2r(g){gsub(/[.+^$(){}|\\]/,"\\\\&",g);gsub(/\*/,"[^\n]*",g);gsub(/\?/,".",g);return "^" g "$"} {n=split(globs,a," ");for(i=1;i<=n;i++) if($0 ~ g2r(a[i])){print 1;exit}}')
    if [ -n "$hit" ] && ! git cat-file -e "HEAD:$p" 2>/dev/null; then hit=1
    elif [ -L "$p" ] && [[ $(readlink -f "$p") == "$work"/* ]]; then hit=1
    elif [ -f "$p" ] && grep -qxF "$(git hash-object "$p")" <<<"$hashes"; then hit=1
    else hit=
    fi
    [ -n "$hit" ] && { echo "L1 $p"; hits=$((hits + 1)); }
  done
  [ "$hits" -eq 0 ]
}

[ $# -ge 1 ] || usage
mode=$1
shift
{
  case "$mode" in
    run) [ $# -eq 2 ] || usage; cmd_run "$@" ;;
    count) [ $# -eq 1 ] || usage; count_tests "$1" ;;
    canary) [ $# -ge 5 ] || usage; cmd_canary "$@" ;;
    verdict) [ $# -eq 4 ] || usage; cmd_verdict "$@" ;;
    notes) [ $# -eq 1 ] || usage; cmd_notes "$1" ;;
    green-for) [ $# -eq 2 ] || usage; cmd_green_for "$@" ;;
    *) usage ;;
  esac
  exit
}
