#!/usr/bin/env bash
set -uo pipefail

INTERVAL=${SIN_FLOW_WATCH_INTERVAL:-600}
HOURS=${SIN_FLOW_WATCH_HOURS:-24}

review=no
[ "${1:-}" = --review ] && { review=yes; shift; }
[ $# -eq 1 ] || [ $# -eq 3 ] || { echo "usage: sin-flow-watch [--review] <PR url> [<first repo> <first branch>]" >&2; exit 2; }
url=$1
first_repo=${2:-}
first_branch=${3:-}
deadline=$(( $(date +%s) + HOURS * 3600 ))
deploy_bots=""
if key=$(sin-flow-profile key 2>/dev/null); then
  deploy_bots=$(sin-flow-profile "$key" get review.deploy_bots 2>/dev/null | tr ',' ' ' || true)
fi

read_state() {
  gh pr view "$url" --json author,baseRefName,mergeStateStatus,reviews,comments,state,headRefOid 2>/dev/null \
    | jq -r --arg bots "$deploy_bots" --arg review "$review" '
        .author.login as $author
        | ($bots | split(" ") | map(select(. != "") | sub("\\[bot\\]$"; ""))) as $skip
        | ([(.reviews[], .comments[]) | .author.login | select(($review == "yes" or . != $author) and ((sub("\\[bot\\]$"; "") | IN($skip[])) | not))] | length) as $seen
        | "\(.baseRefName) \(.mergeStateStatus) \($seen) \(.state) \(.headRefOid)"' 2>/dev/null
}

first=""
until [ -n "$first" ]; do
  [ "$(date +%s)" -lt "$deadline" ] || { echo "TIMEOUT: no PR state read in ${HOURS} h"; exit 0; }
  first=$(read_state)
  [ -n "$first" ] || sleep "$INTERVAL"
done
read -r base0 _ seen0 _ head0 <<<"$first"
default=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null)

while [ "$(date +%s)" -lt "$deadline" ]; do
  sleep "$INTERVAL"
  git fetch -q origin 2>/dev/null
  now=$(read_state)
  [ -n "$now" ] || continue
  read -r base merge seen state head <<<"$now"
  [ "$state" = MERGED ] && { echo "WAKE merged: $url"; exit 0; }
  [ "$base" = "$base0" ] || { echo "WAKE base: $base0 -> $base"; exit 0; }
  [ "$merge" = DIRTY ] && { echo "WAKE DIRTY"; exit 0; }
  [ "$seen" -gt "$seen0" ] && { echo "WAKE activity: $(( seen - seen0 )) new review or comment"; exit 0; }
  [ "$review" = yes ] && [ "$head" != "$head0" ] && { echo "WAKE head: ${head0:0:8} -> ${head:0:8}"; exit 0; }
  if [ -n "$default" ] && [ "$base" != "$default" ] && git rev-parse -q --verify "origin/$base" >/dev/null; then
    [ "$(git rev-list --count "HEAD..origin/$base")" -gt 0 ] && { echo "WAKE base has new commits: origin/$base"; exit 0; }
  fi
  if [ -n "$first_branch" ]; then
    merged=$(gh pr list -R "$first_repo" --head "$first_branch" --state merged --json url -q '.[0].url' 2>/dev/null)
    [ -n "$merged" ] && { echo "WAKE first PR merged: $merged"; exit 0; }
  fi
done
echo "TIMEOUT: ${HOURS} h with no wake"
