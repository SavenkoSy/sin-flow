#!/usr/bin/env bash
set -euo pipefail

FLOW_HOME="${FLOW_HOME:-$HOME/.claude/sin-flow}"
PROFILES="$FLOW_HOME/profiles"
PLUGIN_JSON="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/.claude-plugin/plugin.json"
SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
GRID="$(dirname "$PLUGIN_JSON")/../examples/models.tsv"

usage() {
  cat >&2 <<'EOF'
usage: sin-flow-profile key [DIR]
       sin-flow-profile model strong|mid|cheap [DIR]
       sin-flow-profile model <role> [LEVEL] [DIR]
       sin-flow-profile resolve [KEY]
       sin-flow-profile list
       sin-flow-profile <key> dir|file|get FIELD|section HEADING|mirror
       sin-flow-profile validate [--all | KEY...]
       sin-flow-profile user KEY
       sin-flow-profile migrate-user
       sin-flow-profile migrate-options
EOF
  exit 2
}

slug_of() {
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
  url=${url%.git}
  url=${url#*github.com[:/]}
  printf '%s\n' "$url"
}

toplevel_of() { git -C "$1" rev-parse --show-toplevel 2>/dev/null; }

main_checkout_of() {
  local common
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  dirname "$common"
}

frontmatter() { awk 'NR==1 && $0=="---" {inside=1; next} inside && $0=="---" {exit} inside {print}' "$1"; }

field_in() {
  frontmatter "$1" | awk -v f="$2" '
    index($0, f ":") == 1 {
      v = substr($0, length(f) + 2)
      sub(/^[ \t]+/, "", v)
      sub(/[ \t]+#.*$/, "", v)
      sub(/[ \t]+$/, "", v)
      if (v ~ /^".*"$/) v = substr(v, 2, length(v) - 2)
      print v
      exit
    }'
}

expand_home() { case "$1" in "~"/*) printf '%s\n' "$HOME/${1#\~/}" ;; *) printf '%s\n' "$1" ;; esac; }

team_file_for() {
  local key="$1" top
  top=$(toplevel_of "$PWD") || return 1
  [ -f "$top/.claude/flow.md" ] || return 1
  [ "$(field_in "$top/.claude/flow.md" key)" = "$key" ] || return 1
  printf '%s\n' "$top/.claude/flow.md"
}

key_for_dir() {
  local dir="${1:-$PWD}" slug top f
  slug=$(slug_of "$dir") || return 1
  for f in "$PROFILES"/*/profile.md; do
    [ -f "$f" ] || continue
    if [ "$(field_in "$f" repo.slug)" = "$slug" ]; then
      field_in "$f" key
      return 0
    fi
  done
  top=$(toplevel_of "$dir") || return 1
  if [ -f "$top/.claude/flow.md" ]; then
    field_in "$top/.claude/flow.md" key
    return 0
  fi
  return 1
}

get_field() {
  local key="$1" field="$2" v="" team
  if [ -f "$PROFILES/$key/profile.md" ]; then
    v=$(field_in "$PROFILES/$key/profile.md" "$field")
  fi
  if [ -z "$v" ] && [[ $field != tracker.write.* && $field != group_by && $field != tracker.skip_milestones && $field != tracker.adapter ]] && team=$(team_file_for "$key"); then
    v=$(field_in "$team" "$field")
  fi
  [ -n "$v" ] || return 1
  printf '%s\n' "$v"
}

user_field() {
  local env="CLAUDE_PLUGIN_OPTION_$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')" v
  v="${!env:-}"
  [ -n "$v" ] || [ ! -f "$SETTINGS" ] || v=$(jq -r --arg k "$1" '
    [(.pluginConfigs // {}) | to_entries[] | select(.key | startswith("sin-flow@"))][0].value.options[$k] // empty
    | tostring' "$SETTINGS" 2>/dev/null) || v=""
  [ -n "$v" ] || v=$(jq -r --arg k "$1" '.userConfig[$k].default // empty | tostring' "$PLUGIN_JSON")
  [ -z "$v" ] || printf '%s\n' "$v"
}

user_keys() { jq -r '.userConfig | keys[]' "$PLUGIN_JSON"; }

migrate_user() {
  local f="$FLOW_HOME/user.md" id json skipped backup
  [ -f "$f" ] || { echo "no $f" >&2; return 1; }
  json=$(frontmatter "$f" | awk -F': *' 'NF > 1 && $1 ~ /^[A-Za-z0-9_.]+$/ {
      k = $1; v = substr($0, index($0, ":") + 1)
      sub(/^[ \t]+/, "", v); sub(/[ \t]+#.*$/, "", v); sub(/[ \t]+$/, "", v)
      if (v ~ /^".*"$/) v = substr(v, 2, length(v) - 2)
      gsub(/\./, "_", k); print k "\t" v }' \
    | jq -Rn --argjson keys "$(user_keys | jq -R . | jq -s .)" '
      [inputs | split("\t") | {key: .[0], value: .[1]}
        | if .key == "codex_watch" then .key = "reviewer_watch"
          elif .key == "codex_review" then (if .value == "on" or .value == "codex" then {key: "extra_reviewers", value: "codex"} else empty end)
          else . end]
      | {set: (map(select(.key as $k | $keys | index($k))) | from_entries),
         skipped: (map(select(.key as $k | $keys | index($k) | not)) | map(.key))}')
  skipped=$(jq -r '.skipped | join(" ")' <<<"$json")
  id=$(claude plugin list --json | jq -r '[.[] | select((.id | startswith("sin-flow@")) and .enabled)][0].id // empty')
  [ -n "$id" ] || { echo "no enabled sin-flow plugin in claude plugin list" >&2; return 1; }
  jq -c '.set' <<<"$json" | claude plugin configure "$id" --values-stdin >/dev/null
  backup="$FLOW_HOME/backups/$(date +%F)"
  mkdir -p "$backup"
  cp "$f" "$backup/user.md"
  awk 'NR==1 && $0=="---" {inside=1; next} inside && $0=="---" {inside=0; next} !inside {print}' "$backup/user.md" > "$f"
  printf 'migrated to %s: %s\n' "$id" "$(jq -r '.set | keys | join(" ")' <<<"$json")"
  [ -z "$skipped" ] || printf 'not migrated (not a user key): %s\n' "$skipped"
  printf 'backup: %s/user.md\n' "$backup"
}

migrate_options() {
  local marker="$FLOW_HOME/backups/options-migrated" stored='{}' set id
  [ ! -f "$marker" ] || return 0
  [ ! -f "$SETTINGS" ] ||
    stored=$(jq -c '[(.pluginConfigs // {}) | to_entries[] | select(.key | startswith("sin-flow@"))][0].value.options // {}' "$SETTINGS")
  set=$(jq -c '{}
    + (if (.codex_review == "on" or .codex_review == "codex") and ((.extra_reviewers // "") == "")
       then {extra_reviewers: "codex"} else {} end)
    + (if ((.codex_watch // "") != "") and ((.reviewer_watch // "") == "")
       then {reviewer_watch: .codex_watch} else {} end)' <<<"$stored")
  if [ "$set" != '{}' ]; then
    id=$(claude plugin list --json | jq -r '[.[] | select((.id | startswith("sin-flow@")) and .enabled)][0].id // empty')
    [ -n "$id" ] || { echo "no enabled sin-flow plugin in claude plugin list" >&2; return 1; }
    claude plugin configure "$id" --values-stdin <<<"$set" >/dev/null
  fi
  mkdir -p "$(dirname "$marker")"
  date +%F > "$marker"
  jq -r --argjson old "$stored" '
    (if has("extra_reviewers") then "codex_review \($old.codex_review) -> extra_reviewers codex" else empty end),
    (if has("reviewer_watch") then "codex_watch \($old.codex_watch) -> reviewer_watch \(.reviewer_watch)" else empty end)' <<<"$set"
}

model_field() {
  local name="$1" dir="$2" key v=""
  if key=$(key_for_dir "$dir" 2>/dev/null); then v=$(cd "$dir" && get_field "$key" "models.$name" || true); fi
  case "$name" in strong|mid|cheap) [ -n "$v" ] || v=$(user_field "models_$name") ;; esac
  printf '%s' "$v"
}

grid_row() {
  local role="$1" level="$2" dir="$3" key="" files=("$GRID")
  [ ! -f "$FLOW_HOME/models.tsv" ] || files+=("$FLOW_HOME/models.tsv")
  if key=$(key_for_dir "$dir" 2>/dev/null) && [ -f "$PROFILES/$key/models.tsv" ]; then files+=("$PROFILES/$key/models.tsv"); fi
  awk -F'\t' -v role="$role" -v level="$level" '
    FNR == 1 && $1 == "role" { next }
    /^[[:space:]]*$/ { next }
    NF != 4 || $3 !~ /^(strong|mid|cheap|opus|sonnet|haiku|fable|same)$/ || $4 !~ /^(low|medium|high|xhigh|max|-)$/ {
      printf "%s:%d: not a grid row, the row below it in the layers is used. Want 4 tab-separated fields: role, level, model (strong, mid, cheap, opus, sonnet, haiku, fable, same), effort (low, medium, high, xhigh, max, -). Got: %s\n", FILENAME, FNR, $0 > "/dev/stderr"
      next
    }
    $1 == role && $2 == level { exact = $3 " " $4 }
    $1 == role && $2 == "*" { any = $3 " " $4 }
    END { if (exact != "") print exact; else if (any != "") print any }' "${files[@]}"
}

resolve_model() {
  local name="$1" level="$2" dir="$3" v="" row m e
  case "$name" in
    strong|mid|cheap)
      v=$(model_field "$name" "$dir")
      case "$v" in
        opus|sonnet|haiku|fable) printf '%s\n' "$v"; return 0 ;;
        *) echo "models.$name: '$v' is not one of opus, sonnet, haiku, fable" >&2; exit 2 ;;
      esac ;;
  esac
  case "$level" in haiku) level=cheap ;; sonnet) level=mid ;; opus) level=strong ;; esac
  row=$(grid_row "$name" "$level" "$dir")
  [ -n "$row" ] || { echo "no grid row for role '$name', level '$level' (roles: $(awk -F'\t' 'NR > 1 && !seen[$1]++ { printf "%s ", $1 }' "$GRID"))" >&2; exit 2; }
  m="${row% *}"; e="${row#* }"
  case "$name" in setup|sync|ingest|plan|exec|review|learning) v=$(model_field "$name" "$dir"); [ -z "$v" ] || m="$v" ;; esac
  case "$m" in strong|mid|cheap) v=$(model_field "$m" "$dir"); name="$m"; m="$v" ;; esac
  case "$m" in
    opus|sonnet|haiku|fable|same) printf '%s %s\n' "$m" "$e" ;;
    *) echo "models.$name: '$m' is not one of opus, sonnet, haiku, fable" >&2; exit 2 ;;
  esac
}

resolve_line() {
  local arg="${1:-}" key from cwd_key tracker keys f
  cwd_key=$(key_for_dir "$PWD" 2>/dev/null) || cwd_key=""
  keys=$(for f in "$PROFILES"/*/profile.md; do [ -f "$f" ] && field_in "$f" key; done | tr '\n' ' ' || true)
  if [ -n "$arg" ] && { [ -f "$PROFILES/$arg/profile.md" ] || team_file_for "$arg" >/dev/null; }; then
    key="$arg"; from=argument
  elif [ -z "$arg" ] && [ -n "$cwd_key" ]; then
    key="$cwd_key"; from=cwd
  else
    printf 'usage: /sin-flow:sync <key> [take <batch> | new]   keys: %s\n' "${keys% }"
    return 2
  fi
  tracker=$(get_field "$key" tracker.adapter || true)
  [ -n "$tracker" ] || tracker=$(get_field "$key" tracker.board || true)
  case "$tracker" in ""|null) tracker=none ;; esac
  printf 'key: %s · tracker: %s · from: %s · cwd profile: %s\n' "$key" "$tracker" "$from" "${cwd_key:-none}"
}

section_of() {
  awk -v h="$2" '
    /^## / { inside = (index($0, "## " h) == 1); if (inside) { print; next } }
    inside { print }' "$1"
}

mirror_route() {
  local v
  v=$(get_field "$1" notes.mirror || true)
  if [ -z "$v" ]; then
    section_of "$PROFILES/$1/profile.md" Inferred 2>/dev/null | grep -q 'plan mirrored to the issue' && v=github || v=off
  fi
  case "$v" in
    on|github) echo github ;;
    off) echo off ;;
    /*|"~"/*) v=$(expand_home "$v"); [ -f "$v" ] && [ -x "$v" ] || { echo "notes.mirror $v is not an executable file" >&2; return 2; }; echo "$v" ;;
    *) echo "notes.mirror '$v' is not off, github or a path" >&2; return 2 ;;
  esac
}

validate_key() {
  local key="$1" here="${2:-}" f="$PROFILES/$1/profile.md" errs=() notes=() slug doc src env_file main var
  if [ ! -f "$f" ]; then
    printf 'FAIL %s: no profile at %s\n' "$key" "$f"
    return 1
  fi
  [ "$(field_in "$f" key)" = "$key" ] || errs+=("key field does not match the folder name")
  slug=$(field_in "$f" repo.slug) || true
  [ -n "$slug" ] || errs+=("repo.slug missing")
  doc=$(field_in "$f" measure.doc) || true
  if [ -z "$doc" ]; then
    errs+=("measure.doc missing (a path or none)")
  elif [ "$doc" != "none" ]; then
    case "$doc" in
      /*|"~"/*) [ -f "$(expand_home "$doc")" ] || errs+=("measure.doc $doc does not exist") ;;
      *)
        if [ -n "$here" ]; then
          [ -f "$here/$doc" ] || errs+=("measure.doc $doc not in $here")
        else
          notes+=("measure.doc relative, checked inside the checkout")
        fi ;;
    esac
  fi
  local sw v
  for sw in light assign status; do
    v=$(field_in "$f" "tracker.write.$sw") || true
    case "$sw:$v" in
      *:|*:on|*:off|assign:own) ;;
      assign:*) errs+=("tracker.write.$sw '$v' is not on, off or own") ;;
      *) errs+=("tracker.write.$sw '$v' is not on or off") ;;
    esac
  done
  v=$(field_in "$f" tracker.stale_days) || true
  case "$v" in ""|[1-9]|[1-9][0-9]) ;; *) errs+=("tracker.stale_days '$v' is not a number from 1 to 99") ;; esac
  v=$(field_in "$f" group_by) || true
  case "$v" in ""|epic|milestone|priority|label|rules|field:?*) ;; *) errs+=("group_by '$v' is not one of epic, milestone, priority, label, rules, field:<name>") ;; esac
  v=$(field_in "$f" tracker.adapter) || true
  case "$v" in ""|/*|"~"/*) ;; *) errs+=("tracker.adapter $v is not an absolute or ~ path") ;; esac
  if [ -n "$v" ] && { [ ! -f "$(expand_home "$v")" ] || [ ! -x "$(expand_home "$v")" ]; }; then errs+=("tracker.adapter $v is not an executable file"); fi
  v=$(field_in "$f" notes.mirror) || true
  [ -z "$v" ] || v=$(mirror_route "$key" 2>&1) || errs+=("$v")
  for src in $(frontmatter "$f" | sed -n 's/^sources\.\([A-Za-z0-9_-]*\)\.env_file:.*/\1/p' | sort -u); do
    env_file=$(field_in "$f" "sources.$src.env_file")
    var=$(field_in "$f" "sources.$src.var") || true
    case "$env_file" in
      /*|"~"/*) env_file=$(expand_home "$env_file") ;;
      *)
        if [ -z "$here" ]; then
          notes+=("sources.$src.env_file relative, checked inside the checkout")
          continue
        fi
        main=$(main_checkout_of "$here")
        env_file="$main/$env_file" ;;
    esac
    if [ ! -f "$env_file" ]; then
      errs+=("sources.$src: $env_file missing")
      continue
    fi
    [ "$(stat -c %a "$env_file" 2>/dev/null || stat -f %Lp "$env_file")" = "600" ] || errs+=("sources.$src: $env_file is not chmod 600")
    if [ -n "$var" ] && ! grep -q "^$var=" "$env_file"; then
      errs+=("sources.$src: variable $var not in $env_file")
    fi
    if git -C "$(dirname "$env_file")" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      git -C "$(dirname "$env_file")" check-ignore -q "$env_file" || errs+=("sources.$src: $env_file is not git-ignored")
    fi
  done
  if [ ${#errs[@]} -gt 0 ]; then
    printf 'FAIL %s: %s\n' "$key" "$(IFS=';'; echo "${errs[*]}")"
    return 1
  fi
  if [ ${#notes[@]} -gt 0 ]; then
    printf 'OK %s (%s)\n' "$key" "$(IFS=';'; echo "${notes[*]}")"
  else
    printf 'OK %s\n' "$key"
  fi
}

validate_here() {
  local key top problems=()
  command -v gh >/dev/null || problems+=("gh missing → brew install gh")
  command -v jq >/dev/null || problems+=("jq missing → brew install jq")
  gh auth status >/dev/null 2>&1 || problems+=("gh not logged in → gh auth login")
  [ -d "$FLOW_HOME/work" ] || problems+=("$FLOW_HOME/work missing → run /sin-flow:setup")
  top=$(toplevel_of "$PWD") || true
  if [ -n "$top" ]; then
    if key=$(key_for_dir "$top"); then
      local out
      out=$(validate_key "$key" "$top") || problems+=("$out")
    else
      problems+=("no profile for $(slug_of "$top" || basename "$top") → run /sin-flow:setup")
    fi
  fi
  if [ ${#problems[@]} -gt 0 ]; then
    printf '%s\n' "${problems[@]}"
    return 1
  fi
}

[ $# -ge 1 ] || usage

case "$1" in
  key)
    key_for_dir "${2:-$PWD}" || { echo "no profile for $(slug_of "${2:-$PWD}" 2>/dev/null || echo "${2:-$PWD}")" >&2; exit 1; } ;;
  resolve) resolve_line "${2:-}" || exit $? ;;
  list)
    for f in "$PROFILES"/*/profile.md; do [ -f "$f" ] && printf '%s\t%s\n' "$(field_in "$f" key)" "$(field_in "$f" repo.slug)"; done ;;
  validate)
    shift
    if [ $# -eq 0 ]; then
      validate_here
    else
      [ "$1" = "--all" ] && set -- $(ls "$PROFILES")
      rc=0
      top=$(toplevel_of "$PWD") || top=""
      here_key=""
      [ -n "$top" ] && here_key=$(key_for_dir "$top" 2>/dev/null || true)
      for k in "$@"; do
        if [ "$k" = "$here_key" ]; then validate_key "$k" "$top" || rc=1; else validate_key "$k" || rc=1; fi
      done
      exit $rc
    fi ;;
  model)
    [ $# -ge 2 ] || usage
    if [ -n "${3:-}" ] && [ -d "$3" ]; then resolve_model "$2" "*" "$3"; else resolve_model "$2" "${3:-*}" "${4:-$PWD}"; fi ;;
  user)
    [ $# -eq 2 ] || usage
    jq -e --arg k "$2" '.userConfig | has($k)' "$PLUGIN_JSON" >/dev/null || { echo "not a user key: $2 (keys: $(user_keys | tr '\n' ' '))" >&2; exit 2; }
    user_field "$2" ;;
  migrate-user) migrate_user ;;
  migrate-options) migrate_options ;;
  -h|--help) usage ;;
  *)
    key="$1"
    [ $# -ge 2 ] || usage
    case "$2" in
      dir) printf '%s\n' "$PROFILES/$key" ;;
      file) printf '%s\n' "$PROFILES/$key/profile.md" ;;
      get) [ $# -ge 3 ] || usage; get_field "$key" "$3" ;;
      section) [ $# -ge 3 ] || usage; section_of "$PROFILES/$key/profile.md" "$3" ;;
      mirror) mirror_route "$key" ;;
      *) usage ;;
    esac ;;
esac
