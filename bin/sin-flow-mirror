#!/usr/bin/env bash
set -euo pipefail

comment=
[ "${1:-}" = --comment ] && { comment=1; shift; }
{ [ $# -eq 1 ] || [ $# -eq 2 ]; } && [ -f "$1" ] || { echo "usage: sin-flow-mirror [--comment] <file> [<dir>]" >&2; exit 2; }

mirror() {
  [ -z "$comment" ] || echo '<!-- sin-flow:plan -->'
  sed -E \
    -e '/^(worktree|measure):/d' \
    -e '\|(^\|[^A-Za-z0-9_:/.-])(~\|/Users/[^/[:space:]]+)/[^[:space:]`)"]*(sin-flow/work/\|/worktrees/\|/evidence/)|d' \
    -e 's|(^\|[^A-Za-z0-9_:/.-])(~\|/Users/[^/[:space:]]+)/([^[:space:]`)"]*/)?([^/[:space:]`)"]+)|\1\4|g' \
    -e 's#(^|[^A-Za-z0-9_/.-])work/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/#\1#g' \
    -e 's|`evidence/|`|g' "$1"
}

[ $# -eq 2 ] || { mirror "$1"; exit 0; }
mkdir -p "$2"
mirror "$1" | LC_ALL=C awk -v dir="$2" -v max=60000 '
  { line[NR] = $0 }
  END {
    part = 1; start = 1
    while (start <= NR) {
      size = 0; heading = 0
      for (i = start; i <= NR; i++) {
        size += length(line[i]) + 1
        if (size > max) break
        if (i > start && line[i] ~ /^## /) heading = i
      }
      cut = i > NR ? NR + 1 : (heading ? heading : (i > start ? i : start + 1))
      file = dir "/mirror-" part ".md"
      if (part > 1) print "<!-- sin-flow:plan part " part " -->" > file
      for (j = start; j < cut; j++) print line[j] > file
      if (cut <= NR) print "\ncontinued in comments" > file
      close(file)
      print file
      start = cut; part++
    }
  }'
