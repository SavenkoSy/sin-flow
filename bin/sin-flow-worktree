#!/usr/bin/env bash
set -euo pipefail

FLOW_HOME="${FLOW_HOME:-$HOME/.claude/sin-flow}"

usage() {
  echo "usage: sin-flow-worktree --repo <checkout> --name <id>-<slug> --branch <branch> --base <origin/base | local branch>" >&2
  exit 2
}

repo="" name="" branch="" base=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo|--name|--branch|--base) printf -v "${1#--}" '%s' "${2:?$1 needs a value}"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$repo" ] && [ -n "$name" ] && [ -n "$branch" ] && [ -n "$base" ] || usage
repo=$(cd "$repo" && git rev-parse --show-toplevel)

user_field() {
  [ -f "$FLOW_HOME/user.md" ] || return 0
  sed -n "s/^$1:[[:space:]]*//p" "$FLOW_HOME/user.md" | sed 's/[[:space:]]#.*//; s/[[:space:]]*$//; s/^"//; s/"$//' | head -1
}

workspace=$(user_field workspace)
workspace=${workspace:-git}
case "$workspace" in orca|git) ;; *) echo "workspace '$workspace' in user.md is not orca or git" >&2; exit 2 ;; esac

existing=$(git -C "$repo" worktree list --porcelain | awk -v ref="refs/heads/$branch" '/^worktree /{p=substr($0,10)} $0=="branch " ref {print p; exit}')
if [ -n "$existing" ]; then
  printf 'mode: %s\npath: %s\nstate: resume\n' "$workspace" "$existing"
  exit 0
fi
if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
  echo "branch $branch exists with no worktree; check it out by hand or pick another branch" >&2
  exit 1
fi

case "$base" in origin/*) git -C "$repo" fetch -q origin "${base#origin/}" ;; esac

if [ "$workspace" = git ]; then
  path="$repo/.claude/worktrees/$name"
  git -C "$repo" worktree add -q "$path" -b "$branch" "$base"
  printf 'mode: git\npath: %s\nstate: new\n' "$path"
  exit 0
fi

create() {
  orca worktree create --repo "path:$repo" --name "$name" --base-branch "$base" --setup skip --no-parent --json
}
out=$(create 2>&1) || {
  case "$out" in *repo_not_found*) orca repo add --path "$repo" --json >/dev/null; out=$(create) ;; *) echo "$out" >&2; exit 1 ;; esac
}
path=$(jq -r '.result.worktree.path' <<<"$out")
[ -n "$path" ] && [ "$path" != null ] || { echo "orca worktree create returned no path: $out" >&2; exit 1; }
git -C "$path" branch -m "$branch"
shell=$(orca terminal list --worktree "path:$path" --json | jq -r '.. | objects | select(has("handle") and (has("agentIdentity") | not)) | .handle' | head -1)
printf 'mode: orca\npath: %s\nstate: new\nshell: %s\n' "$path" "$shell"
