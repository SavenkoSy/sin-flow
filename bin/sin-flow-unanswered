#!/usr/bin/env bash
set -euo pipefail

[ $# -eq 1 ] || { echo "usage: sin-flow-unanswered <PR url>" >&2; exit 2; }
url=$1
[[ $url =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]] || { echo "not a PR url: $url" >&2; exit 2; }
repo=${BASH_REMATCH[1]}
n=${BASH_REMATCH[2]}

author=$(gh pr view "$url" --json author -q .author.login)
deploy_bots=""
if key=$(sin-flow-profile key 2>/dev/null); then
  deploy_bots=$(sin-flow-profile "$key" get review.deploy_bots 2>/dev/null | tr ',' ' ' || true)
fi

gh api --paginate "repos/$repo/pulls/$n/comments" | jq -rs --arg author "$author" --arg bots "$deploy_bots" '
  ($bots | split(" ") | map(select(. != "") | sub("\\[bot\\]$"; ""))) as $skip
  | (add // [])
  | group_by(.in_reply_to_id // .id)[]
  | sort_by(.created_at)
  | .[0] as $root
  | .[-1] as $last
  | select($last.user.login != $author)
  | select(($root.user.login | sub("\\[bot\\]$"; "") | IN($skip[])) | not)
  | "thread \($root.id) \($last.user.login) \($root.path):\($root.line // $root.original_line) \($last.body | gsub("\\s+"; " ") | .[0:100])"'

gh api --paginate "repos/$repo/issues/$n/comments" | jq -rs --arg author "$author" --arg bots "$deploy_bots" '
  ($bots | split(" ") | map(select(. != "") | sub("\\[bot\\]$"; ""))) as $skip
  | (add // [])
  | ([.[] | select(.user.login == $author) | .created_at] | max // "") as $answered
  | .[]
  | select(.user.login != $author and .created_at > $answered)
  | select((.user.login | sub("\\[bot\\]$"; "") | IN($skip[])) | not)
  | "comment \(.id) \(.user.login) \(.body | gsub("\\s+"; " ") | .[0:100])"'
